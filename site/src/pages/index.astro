---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDocs } from '../lib/docs';

const docs = await getDocs();
const featuredDocs = docs.filter((doc) =>
  ['user-guide', 'installation', 'reader-features', 'webserver'].includes(doc.slug)
);
---

<SiteLayout
  title="CrossInk Academic"
  description="Academic-focused e-reader firmware for Xteink X4 and X3 devices."
  pageClass="home"
>
  <section slot="hero" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A research-focused fork of <a href="https://crosspointreader.com/">CrossPoint</a></p>
      <h1>Cross<span class="crossink-serif">Ink</span><br />Academic</h1>
      <p class="hero-text">
        Academic notes, highlights, annotation tags, and open-book discovery for Xteink readers.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/jbfarias/CrossInk-academic/releases/tag/v1.5.2">Download v1.5.2</a>
        <a class="button" href="/installation.html">Installation Instructions</a>
      </div>
    </div>
    <img
      src="/images/bitter-small-15-margin.jpg"
      alt="CrossInk on an X4 using 10pt Bitter font"
      class="hero-image"
      loading="eager"
    />
  </section>

  <section class="release-section" aria-labelledby="release-title">
    <div class="section-heading">
      <p class="eyebrow">Official release</p>
      <h2 id="release-title">CrossInk Academic v1.5.2</h2>
    </div>
    <p>
      The current release preserves the fork's ClippingStore v4 format and document identity while adding compatible academic notes, highlights, user-defined tags, and Project Gutenberg as a bundled OPDS catalog.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="https://github.com/jbfarias/CrossInk-academic/releases/download/v1.5.2/firmware-x3-x4-v1.5.2.bin">Firmware X3/X4</a>
      <a class="button" href="https://github.com/jbfarias/CrossInk-academic/releases/download/v1.5.2/firmware-x3-x4-debug-v1.5.2.bin">Firmware X3/X4 (logger)</a>
      <a class="button" href="https://github.com/jbfarias/CrossInk-academic/releases/tag/v1.5.2">Release notes</a>
    </div>
    <div class="intro-grid">
      <div>
        <span>Annotations</span>
        <strong>Notes, highlights, academic tags, and the web `/highlights` page.</strong>
      </div>
      <div>
        <span>Open books</span>
        <strong>Project Gutenberg is included as an official OPDS catalog.</strong>
      </div>
      <div>
        <span>Diagnostics</span>
        <strong>The logger build enables detailed serial logs and writes a crash report to the SD card after a panic.</strong>
      </div>
    </div>
  </section>

  <section class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Useful docs</h2>
  </section>
  <nav class="useful-docs" aria-label="Useful documentation">
    {
      featuredDocs.map((doc) => (
        <a href={doc.url}>
          <span>{doc.title}</span>
        </a>
      ))
    }
  </nav>
</SiteLayout>
